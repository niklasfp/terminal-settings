{
  "$comment": "Hand-written layer of the Rio settings schema: labels, docs, ranges, widgets, grouping. Keys, types and defaults come from rio-source.json; anything listed here that the dump lacks must set \"manual\": true.",

  "app": { "terminal": "Rio", "title": "Rio settings", "brand": "rio", "scopes": ["macos", "linux", "windows"], "themeLocksColors": true },

  "platformOverridable": ["window.", "navigation.", "renderer.", "shell.", "env-vars", "theme"],
  "platformOverrideExclude": ["window.opacity-cells", "window.quake-width-percentage", "window.quake-height-percentage", "renderer.use-cpu"],

  "groups": [
    { "id": "general",    "title": "General",     "icon": "sliders",  "doc": "Behaviour that applies to every window." },
    { "id": "window",     "title": "Window",      "icon": "window",   "doc": "Size, transparency and decorations of the Rio window." },
    { "id": "fonts",      "title": "Fonts",       "icon": "type",     "doc": "Font family, size and per-style faces. `fonts.family` overrides every style." },
    { "id": "theme",      "title": "Theme",       "icon": "palette",  "doc": "Pick a theme file from the themes folder, or follow the system appearance." },
    { "id": "colors",     "title": "Colors",      "icon": "droplet",  "doc": "Custom colors. Ignored while a theme is set." },
    { "id": "cursor",     "title": "Cursor",      "icon": "cursor",   "doc": "Cursor shape, blinking and trail effect." },
    { "id": "navigation", "title": "Navigation",  "icon": "tabs",     "doc": "Tabs, splits and how they look." },
    { "id": "layout",     "title": "Layout",      "icon": "layout",   "doc": "Margins and split panels. Values are CSS-style: 1, 2 or 4 numbers." },
    { "id": "shell",      "title": "Shell",       "icon": "terminal", "doc": "The program Rio runs, its environment and working directory." },
    { "id": "keyboard",   "title": "Keyboard",    "icon": "keyboard", "doc": "Key handling and IME." },
    { "id": "bindings",   "title": "Key bindings","icon": "command",  "doc": "Custom key bindings, added on top of Rio's defaults." },
    { "id": "hints",      "title": "Hints",       "icon": "link",     "doc": "Hint mode: regex matches you can open, copy or select from the keyboard." },
    { "id": "bell",       "title": "Bell",        "icon": "bell",     "doc": "What happens when a program rings the bell." },
    { "id": "renderer",   "title": "Renderer",    "icon": "cpu",      "doc": "GPU backend and render loop. Most people never need these." },
    { "id": "developer",  "title": "Developer",   "icon": "bug",      "doc": "Logging and diagnostics." }
  ],

  "settings": [
    { "key": "confirm-before-quit", "group": "general", "label": "Confirm before quit", "type": "bool", "doc": "Ask before closing Rio." },
    { "key": "copy-on-select", "group": "general", "label": "Copy on select", "type": "bool", "doc": "Copy selected text to the clipboard automatically." },
    { "key": "hide-mouse-cursor-when-typing", "group": "general", "label": "Hide mouse while typing", "type": "bool" },
    { "key": "option-as-alt", "group": "general", "label": "Option as Alt", "type": "enum", "values": ["none", "both", "left", "right"], "platforms": ["macos"], "doc": "Which Option keys act as Alt instead of typing special characters." },
    { "key": "enable-scroll-bar", "group": "general", "label": "Scroll bar", "type": "bool" },
    { "key": "scrollback-history-limit", "group": "general", "label": "Scrollback lines", "type": "int", "min": 0, "step": 1000, "doc": "Lines kept in history. 0 disables scrollback." },
    { "key": "scroll.multiplier", "group": "general", "label": "Scroll multiplier", "type": "float", "min": 0.1, "max": 20, "step": 0.1, "subgroup": "Scrolling" },
    { "key": "scroll.divider", "group": "general", "label": "Scroll divider", "type": "float", "min": 0.1, "max": 20, "step": 0.1, "subgroup": "Scrolling" },
    { "key": "line-height", "group": "general", "label": "Line height", "type": "float", "min": 1, "max": 3, "step": 0.05, "subgroup": "Text", "doc": "Multiplier for line spacing. Values below 1.0 are not allowed." },
    { "key": "grapheme-clustering", "group": "general", "label": "Grapheme clustering", "type": "bool", "subgroup": "Text", "doc": "Lay out cells by Unicode grapheme clusters (DEC mode 2027). Off gives legacy wcwidth layout." },
    { "key": "draw-bold-text-with-light-colors", "group": "general", "label": "Bold text uses bright colors", "type": "bool", "subgroup": "Text" },
    { "key": "ignore-selection-foreground-color", "group": "general", "label": "Keep text color in selection", "type": "bool", "subgroup": "Text", "doc": "Ignore the selection foreground color and keep the original text color." },
    { "key": "title.content", "group": "general", "label": "Window title", "type": "string", "subgroup": "Title", "doc": "Template. Variables: TITLE, PROGRAM, ABSOLUTE_PATH, RELATIVE_PATH, COLUMNS, LINES. `||` falls back when empty." },
    { "key": "title.placeholder", "group": "general", "label": "Initial title", "type": "string", "subgroup": "Title", "nullable": true },

    { "key": "window.width", "group": "window", "label": "Width", "type": "int", "min": 100, "step": 10, "unit": "px", "subgroup": "Size" },
    { "key": "window.height", "group": "window", "label": "Height", "type": "int", "min": 100, "step": 10, "unit": "px", "subgroup": "Size" },
    { "key": "window.columns", "group": "window", "label": "Columns", "type": "int", "min": 0, "nullable": true, "subgroup": "Size", "doc": "Overrides width when set. 0 is ignored." },
    { "key": "window.rows", "group": "window", "label": "Rows", "type": "int", "min": 0, "nullable": true, "subgroup": "Size", "doc": "Overrides height when set. 0 is ignored." },
    { "key": "window.mode", "group": "window", "label": "Startup mode", "type": "enum", "enum": "WindowMode", "subgroup": "Size" },
    { "key": "window.opacity", "group": "window", "label": "Opacity", "type": "float", "min": 0, "max": 1, "step": 0.01, "subgroup": "Transparency" },
    { "key": "window.opacity-cells", "group": "window", "label": "Opacity applies to cells", "type": "bool", "subgroup": "Transparency", "doc": "Also make cells with an explicit background color transparent." },
    { "key": "window.blur", "group": "window", "label": "Background blur", "type": "blur", "subgroup": "Transparency", "doc": "Glass styles need macOS 26 or later. Changes need a restart." },
    { "key": "window.background-image.path", "group": "window", "label": "Background image", "type": "path", "pick": "image", "manual": true, "nullable": true, "subgroup": "Transparency", "doc": "Absolute path to an image file." },
    { "key": "window.background-image.opacity", "group": "window", "label": "Background image opacity", "type": "float", "min": 0, "max": 1, "step": 0.01, "manual": true, "default": 1.0, "nullable": true, "subgroup": "Transparency" },
    { "key": "window.decorations", "group": "window", "label": "Decorations", "type": "enum", "enum": "Decorations", "subgroup": "Decorations" },
    { "key": "window.colorspace", "group": "window", "label": "Color space", "type": "enum", "enum": "Colorspace", "subgroup": "Decorations", "doc": "How hex and ANSI color values are interpreted. Not in the official docs yet." },
    { "key": "window.macos-use-unified-titlebar", "group": "window", "label": "Unified title bar", "type": "bool", "platforms": ["macos"], "subgroup": "macOS" },
    { "key": "window.macos-use-shadow", "group": "window", "label": "Window shadow", "type": "bool", "platforms": ["macos"], "subgroup": "macOS" },
    { "key": "window.macos-traffic-light-position-x", "group": "window", "label": "Traffic lights X", "type": "float", "nullable": true, "unit": "pt", "platforms": ["macos"], "subgroup": "macOS", "doc": "Points from the left edge. Ignored in Tab navigation mode." },
    { "key": "window.macos-traffic-light-position-y", "group": "window", "label": "Traffic lights Y", "type": "float", "nullable": true, "unit": "pt", "platforms": ["macos"], "subgroup": "macOS", "doc": "Points from the top edge. Ignored in Tab navigation mode." },
    { "key": "window.windows-corner-preference", "group": "window", "label": "Corner style", "type": "enum", "enum": "WindowsCornerPreference", "nullable": true, "platforms": ["windows"], "subgroup": "Windows" },
    { "key": "window.windows-use-undecorated-shadow", "group": "window", "label": "Undecorated shadow", "type": "bool", "nullable": true, "platforms": ["windows"], "subgroup": "Windows" },
    { "key": "window.windows-use-no-redirection-bitmap", "group": "window", "label": "No redirection bitmap", "type": "bool", "nullable": true, "platforms": ["windows"], "subgroup": "Windows", "doc": "Sets WS_EX_NOREDIRECTIONBITMAP." },
    { "key": "window.quake-width-percentage", "group": "window", "label": "Quake width", "type": "float", "min": 0.1, "max": 1, "step": 0.05, "subgroup": "Quake mode", "doc": "Fraction of the monitor width." },
    { "key": "window.quake-height-percentage", "group": "window", "label": "Quake height", "type": "float", "min": 0.1, "max": 1, "step": 0.05, "subgroup": "Quake mode", "doc": "Fraction of the monitor height." },

    { "key": "fonts.family", "group": "fonts", "label": "Family (all styles)", "type": "font", "manual": true, "nullable": true, "doc": "Overrides the family of every style below." },
    { "key": "fonts.size", "group": "fonts", "label": "Size", "type": "float", "min": 6, "max": 48, "step": 0.5, "unit": "pt", "manual": true, "default": 14.0 },
    { "key": "fonts.features", "group": "fonts", "label": "OpenType features", "type": "strings", "manual": true, "default": [], "placeholder": "e.g. ss01, -liga, cv01=2", "doc": "A tag enables a feature, -tag disables it, tag=value sets it." },
    { "key": "fonts.hinting", "group": "fonts", "label": "Hinting", "type": "bool", "manual": true, "default": true },
    { "key": "fonts.use-drawable-chars", "group": "fonts", "label": "Built-in box drawing", "type": "bool", "manual": true, "default": true, "doc": "Draw box, block, Braille and Powerline characters natively instead of from the font." },
    { "key": "fonts.disable-warnings-not-found", "group": "fonts", "label": "Silence missing-font warnings", "type": "bool", "manual": true, "default": false },
    { "key": "fonts.additional-dirs", "group": "fonts", "label": "Extra font folders", "type": "strings", "pick": "folder", "manual": true, "default": [], "placeholder": "/path/to/fonts" },
    { "key": "fonts.regular.family", "group": "fonts", "label": "Family", "type": "font", "manual": true, "default": "cascadiacode", "subgroup": "Regular" },
    { "key": "fonts.regular.style", "group": "fonts", "label": "Style", "type": "fontStyle", "manual": true, "default": "default", "subgroup": "Regular" },
    { "key": "fonts.regular.weight", "group": "fonts", "label": "Weight", "type": "int", "min": 100, "max": 900, "step": 100, "manual": true, "nullable": true, "subgroup": "Regular" },
    { "key": "fonts.bold.family", "group": "fonts", "label": "Family", "type": "font", "manual": true, "default": "cascadiacode", "subgroup": "Bold" },
    { "key": "fonts.bold.style", "group": "fonts", "label": "Style", "type": "fontStyle", "manual": true, "default": "default", "subgroup": "Bold" },
    { "key": "fonts.bold.weight", "group": "fonts", "label": "Weight", "type": "int", "min": 100, "max": 900, "step": 100, "manual": true, "nullable": true, "subgroup": "Bold" },
    { "key": "fonts.italic.family", "group": "fonts", "label": "Family", "type": "font", "manual": true, "default": "cascadiacode", "subgroup": "Italic" },
    { "key": "fonts.italic.style", "group": "fonts", "label": "Style", "type": "fontStyle", "manual": true, "default": "default", "subgroup": "Italic" },
    { "key": "fonts.italic.weight", "group": "fonts", "label": "Weight", "type": "int", "min": 100, "max": 900, "step": 100, "manual": true, "nullable": true, "subgroup": "Italic" },
    { "key": "fonts.bold-italic.family", "group": "fonts", "label": "Family", "type": "font", "manual": true, "default": "cascadiacode", "subgroup": "Bold italic" },
    { "key": "fonts.bold-italic.style", "group": "fonts", "label": "Style", "type": "fontStyle", "manual": true, "default": "default", "subgroup": "Bold italic" },
    { "key": "fonts.bold-italic.weight", "group": "fonts", "label": "Weight", "type": "int", "min": 100, "max": 900, "step": 100, "manual": true, "nullable": true, "subgroup": "Bold italic" },
    { "key": "fonts.symbol-map", "group": "fonts", "label": "Symbol map", "type": "records", "manual": true, "default": [], "subgroup": "Fallbacks",
      "doc": "Use a specific font for a Unicode range.",
      "fields": [
        { "key": "start", "label": "Start", "type": "string", "placeholder": "E0A0" },
        { "key": "end", "label": "End", "type": "string", "placeholder": "E0D4" },
        { "key": "font-family", "label": "Font", "type": "font" }
      ] },

    { "key": "theme", "group": "theme", "label": "Theme", "type": "theme", "doc": "Name of a file in the themes folder, without .toml. Empty uses the colors below." },
    { "key": "force-theme", "group": "theme", "label": "Force appearance", "type": "enum", "enum": "AppearanceTheme", "values": ["dark", "light"], "nullable": true, "doc": "Ignore the system appearance." },
    { "key": "adaptive-theme.light", "group": "theme", "label": "Light theme", "type": "theme", "manual": true, "nullable": true, "subgroup": "Follow system appearance", "doc": "Used when the system is in light mode. Set both to enable." },
    { "key": "adaptive-theme.dark", "group": "theme", "label": "Dark theme", "type": "theme", "manual": true, "nullable": true, "subgroup": "Follow system appearance", "doc": "Used when the system is in dark mode." },

    { "key": "cursor.shape", "group": "cursor", "label": "Shape", "type": "enum", "enum": "CursorShape" },
    { "key": "cursor.blinking", "group": "cursor", "label": "Blinking", "type": "bool" },
    { "key": "cursor.blinking-interval", "group": "cursor", "label": "Blink interval", "type": "int", "min": 350, "max": 1200, "step": 50, "unit": "ms" },
    { "key": "effects.custom-mouse-cursor", "group": "cursor", "label": "Custom mouse cursor", "type": "bool", "subgroup": "Effects" },
    { "key": "effects.trail-cursor", "group": "cursor", "label": "Trail cursor", "type": "bool", "subgroup": "Effects", "doc": "Animate a trail behind the cursor when it moves." },
    { "key": "effects.trail-cursor-color", "group": "cursor", "label": "Trail color", "type": "color", "nullable": true, "subgroup": "Effects", "doc": "Unset uses the cursor color." },
    { "key": "effects.trail-cursor-opacity", "group": "cursor", "label": "Trail opacity", "type": "float", "min": 0, "max": 1, "step": 0.05, "subgroup": "Effects" },
    { "key": "effects.trail-cursor-decay", "group": "cursor", "label": "Trail decay (fast, slow)", "type": "pair", "unit": "ms", "subgroup": "Effects" },
    { "key": "effects.trail-cursor-start-threshold", "group": "cursor", "label": "Trail start threshold", "type": "int", "min": 0, "max": 20, "unit": "cells", "subgroup": "Effects", "doc": "0 animates every movement." },

    { "key": "navigation.mode", "group": "navigation", "label": "Mode", "type": "enum", "enum": "NavigationMode", "doc": "NativeTab is macOS only." },
    { "key": "navigation.hide-if-single", "group": "navigation", "label": "Hide tab bar with one tab", "type": "bool" },
    { "key": "navigation.current-working-directory", "group": "navigation", "label": "New tabs keep working directory", "type": "bool", "doc": "Needs use-fork off." },
    { "key": "navigation.use-terminal-title", "group": "navigation", "label": "Tabs use terminal title", "type": "bool" },
    { "key": "navigation.clickable", "group": "navigation", "label": "Clickable tabs", "type": "bool", "manual": true, "default": false },
    { "key": "navigation.max-tab-width", "group": "navigation", "label": "Max tab width", "type": "float", "min": 80, "max": 280, "step": 10, "unit": "px" },
    { "key": "navigation.use-split", "group": "navigation", "label": "Enable splits", "type": "bool", "subgroup": "Splits" },
    { "key": "navigation.open-config-with-split", "group": "navigation", "label": "Open config in a split", "type": "bool", "subgroup": "Splits" },
    { "key": "navigation.unfocused-split-opacity", "group": "navigation", "label": "Unfocused split opacity", "type": "float", "min": 0.15, "max": 1, "step": 0.05, "subgroup": "Splits" },
    { "key": "navigation.unfocused-split-fill", "group": "navigation", "label": "Unfocused split fill", "type": "color", "nullable": true, "subgroup": "Splits", "doc": "Unset uses the terminal background." },
    { "key": "navigation.color-automation", "group": "navigation", "label": "Tab color rules", "type": "records", "manual": true, "default": [], "subgroup": "Tab colors",
      "doc": "Color a tab by the program running in it or its path.",
      "fields": [
        { "key": "program", "label": "Program", "type": "string", "placeholder": "nvim" },
        { "key": "path", "label": "Path", "type": "string", "placeholder": "/Users/me/work" },
        { "key": "color", "label": "Color", "type": "color" }
      ] },

    { "key": "margin", "group": "layout", "label": "Window margin", "type": "margin", "unit": "px" },
    { "key": "panel.padding", "group": "layout", "label": "Panel padding", "type": "margin", "unit": "px", "subgroup": "Split panels" },
    { "key": "panel.margin", "group": "layout", "label": "Panel margin", "type": "margin", "unit": "px", "subgroup": "Split panels" },
    { "key": "panel.row-gap", "group": "layout", "label": "Row gap", "type": "float", "min": 0, "max": 40, "step": 1, "unit": "px", "subgroup": "Split panels" },
    { "key": "panel.column-gap", "group": "layout", "label": "Column gap", "type": "float", "min": 0, "max": 40, "step": 1, "unit": "px", "subgroup": "Split panels" },
    { "key": "panel.border-width", "group": "layout", "label": "Border width", "type": "float", "min": 0, "max": 10, "step": 0.5, "unit": "px", "subgroup": "Split panels" },
    { "key": "panel.border-radius", "group": "layout", "label": "Border radius", "type": "float", "min": 0, "max": 20, "step": 1, "unit": "px", "subgroup": "Split panels" },

    { "key": "shell.program", "group": "shell", "label": "Program", "type": "path", "pick": "file", "manual": true, "nullable": true, "placeholder": "login shell", "doc": "Unset uses your login shell (PowerShell on Windows)." },
    { "key": "shell.args", "group": "shell", "label": "Arguments", "type": "strings" },
    { "key": "working-dir", "group": "shell", "label": "Working directory", "type": "path", "pick": "folder", "nullable": true, "doc": "Only works when use-fork is off." },
    { "key": "env-vars", "group": "shell", "label": "Environment variables", "type": "strings", "placeholder": "NAME=value", "doc": "Platform overrides are appended to these." },
    { "key": "use-fork", "group": "shell", "label": "Use fork", "type": "bool", "doc": "Spawn the shell with fork instead of spawn. Not available on Windows." },
    { "key": "shell-integration", "group": "shell", "label": "Shell integration", "type": "bool", "doc": "Inject integration into zsh and fish so the working directory reaches Rio." },
    { "key": "editor.program", "group": "shell", "label": "Editor", "type": "path", "pick": "file", "subgroup": "Config editor", "doc": "Opened by the OpenConfigEditor binding. Bare names resolve in /usr/bin; use a full path otherwise." },
    { "key": "editor.args", "group": "shell", "label": "Editor arguments", "type": "strings", "subgroup": "Config editor" },

    { "key": "keyboard.disable-ctlseqs-alt", "group": "keyboard", "label": "Disable Alt control sequences", "type": "bool" },
    { "key": "keyboard.ime-cursor-positioning", "group": "keyboard", "label": "IME follows cursor", "type": "bool" },
    { "key": "keyboard.forward-to-ime-modifier-mask", "group": "keyboard", "label": "Modifiers forwarded to IME", "type": "flags", "values": ["shift", "ctrl", "alt", "super"] },

    { "key": "bindings.keys", "group": "bindings", "label": "Bindings", "type": "records",
      "doc": "Use `with` for modifiers (super, shift, control, alt joined by |), and either action or esc.",
      "fields": [
        { "key": "key", "label": "Key", "type": "string", "placeholder": "t" },
        { "key": "with", "label": "With", "type": "string", "placeholder": "super | shift" },
        { "key": "action", "label": "Action", "type": "string", "placeholder": "CreateTab" },
        { "key": "esc", "label": "Escape seq.", "type": "string", "placeholder": "\\u001b[1;5C" },
        { "key": "mode", "label": "Mode", "type": "string", "placeholder": "vi | ~alt" }
      ] },

    { "key": "hints.alphabet", "group": "hints", "label": "Label alphabet", "type": "string" },
    { "key": "hints.rules", "group": "hints", "label": "Rules", "type": "raw",
      "doc": "Edited as TOML ([[hints.rules]] blocks). Leave empty to keep Rio's default URL rule." },

    { "key": "bell.audio", "group": "bell", "label": "Sound", "type": "bool", "doc": "Linux/BSD builds need the audio feature." },
    { "key": "bell.tab-indicator", "group": "bell", "label": "Tab indicator", "type": "bool", "doc": "Show a dot on background tabs that rang the bell." },

    { "key": "renderer.backend", "group": "renderer", "label": "Backend", "type": "enum", "enum": "Backend", "manual": true, "default": "metal", "doc": "Default is Metal on macOS, Vulkan on Linux, Webgpu elsewhere. Non-native backends need the wgpu build." },
    { "key": "renderer.strategy", "group": "renderer", "label": "Strategy", "type": "enum", "enum": "RendererStategy", "doc": "Game runs a continuous loop and uses more CPU." },
    { "key": "renderer.disable-unfocused-render", "group": "renderer", "label": "Pause when unfocused", "type": "bool" },
    { "key": "renderer.disable-occluded-render", "group": "renderer", "label": "Pause when hidden", "type": "bool" },
    { "key": "renderer.use-cpu", "group": "renderer", "label": "CPU rasterizer", "type": "bool", "doc": "Experimental." },
    { "key": "renderer.filters", "group": "renderer", "label": "Filters", "type": "strings", "pick": "file", "manual": true, "default": [], "placeholder": "NewPixieCrt", "doc": "Built-in NewPixieCrt or fubax_vr, or a .slangp path. Needs the Webgpu backend." },

    { "key": "developer.log-level", "group": "developer", "label": "Log level", "type": "enum", "values": ["OFF", "ERROR", "WARN", "INFO", "DEBUG", "TRACE"] },
    { "key": "developer.enable-log-file", "group": "developer", "label": "Write log file", "type": "bool", "doc": "Writes ~/.config/rio/log/rio.log." },
    { "key": "developer.enable-fps-counter", "group": "developer", "label": "FPS counter", "type": "bool" }
  ],

  "colorSubgroups": [
    { "title": "Base", "match": ["background", "foreground", "cursor", "vi-cursor"] },
    { "title": "Normal", "match": ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"] },
    { "title": "Bright", "prefix": "light-" },
    { "title": "Dim", "prefix": "dim-" },
    { "title": "Selection", "prefix": "selection-" },
    { "title": "Search", "prefix": "search-" },
    { "title": "Hints", "prefix": "hint-" },
    { "title": "Tabs and splits", "match": ["tabs", "tabs-active", "split", "split-active"] }
  ]
}
