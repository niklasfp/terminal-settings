{
  "$comment": "Hand-written layer of the Ghostty settings schema. Keys, types, defaults and docs come from ghostty-source.json (Ghostty's own +show-config --docs and Config.zig); this file only groups them, names a few widgets and adds ranges.",

  "app": { "terminal": "Ghostty", "title": "Ghostty settings", "brand": "ghostty", "themeLocksColors": false },

  "groups": [
    { "id": "general",    "title": "General",       "icon": "sliders",  "doc": "App behaviour, windows on launch and closing." },
    { "id": "fonts",      "title": "Fonts",         "icon": "type",     "doc": "Families, size, features and fine metric adjustments." },
    { "id": "colors",     "title": "Theme & colors","icon": "palette",  "doc": "Theme, base colors, palette and contrast. Colors set here apply on top of the theme." },
    { "id": "window",     "title": "Window",        "icon": "window",   "doc": "Size, padding, transparency, decorations and splits." },
    { "id": "background", "title": "Background",    "icon": "droplet",  "doc": "Background image and blur." },
    { "id": "cursor",     "title": "Cursor",        "icon": "cursor",   "doc": "Cursor shape, color and blinking." },
    { "id": "mouse",      "title": "Mouse & selection", "icon": "cursor", "doc": "Mouse reporting, scrolling, clicks and text selection." },
    { "id": "clipboard",  "title": "Clipboard",     "icon": "link",     "doc": "Clipboard access and paste protection." },
    { "id": "shell",      "title": "Shell",         "icon": "terminal", "doc": "The command Ghostty runs, its environment, shell integration and scrollback." },
    { "id": "keybinds",   "title": "Key bindings",  "icon": "command",  "doc": "Custom bindings are added on top of Ghostty's defaults (`ghostty +list-keybinds --default`)." },
    { "id": "quick",      "title": "Quick terminal","icon": "tabs",     "doc": "The drop-down quick terminal." },
    { "id": "notify",     "title": "Bell & notifications", "icon": "bell", "doc": "Bell, desktop notifications and command-finished alerts." },
    { "id": "macos",      "title": "macOS",         "icon": "window",   "doc": "Settings that only apply to the macOS app." },
    { "id": "linux",      "title": "Linux & GTK",   "icon": "cpu",      "doc": "Settings that only apply to the GTK (Linux/FreeBSD) app." },
    { "id": "advanced",   "title": "Advanced",      "icon": "bug",      "doc": "Shaders, terminal protocol details, includes and updates." }
  ],

  "rules": [
    { "group": "fonts",      "prefix": ["font-", "adjust-", "freetype-", "grapheme-width-method", "alpha-blending", "clipboard-codepoint-map"] },
    { "group": "colors",     "prefix": ["theme", "background", "foreground", "palette", "minimum-contrast", "bold-color", "faint-opacity", "selection-foreground", "selection-background", "search-"] },
    { "group": "background", "prefix": ["background-image", "background-blur", "background-opacity"] },
    { "group": "cursor",     "prefix": ["cursor-"] },
    { "group": "mouse",      "prefix": ["mouse-", "click-", "right-click-action", "middle-click-action", "focus-follows-mouse", "selection-", "scroll-to-bottom", "link-", "copy-on-select"] },
    { "group": "clipboard",  "prefix": ["clipboard-"] },
    { "group": "shell",      "prefix": ["command", "initial-command", "env", "input", "working-directory", "shell-integration", "wait-after-command", "abnormal-command-exit-runtime", "scrollback-", "scrollbar", "term"] },
    { "group": "keybinds",   "prefix": ["keybind", "key-remap", "command-palette-entry"] },
    { "group": "quick",      "prefix": ["quick-terminal-", "gtk-quick-terminal-"] },
    { "group": "notify",     "prefix": ["bell-", "notify-on-command-finish", "app-notifications", "desktop-notifications", "progress-style"] },
    { "group": "macos",      "prefix": ["macos-", "auto-update", "undo-timeout"] },
    { "group": "linux",      "prefix": ["gtk-", "linux-", "x11-", "async-backend", "class", "language", "window-subtitle", "window-show-tab-bar", "window-titlebar-"] },
    { "group": "window",     "prefix": ["window-", "unfocused-split-", "split-", "resize-overlay", "maximize", "fullscreen", "title", "tab-inherit-working-directory", "drag-handle"] },
    { "group": "advanced",   "prefix": ["custom-shader", "osc-", "vt-", "image-storage-limit", "config-", "enquiry-response", "title-report"] },
    { "group": "general",    "prefix": [""] }
  ],

  "platformPrefixes": { "macos-": ["macos"], "gtk-": ["linux"], "linux-": ["linux"], "x11-": ["linux"], "freetype-": ["linux"] },

  "typeMap": {
    "FontStyle": "fontStyle",
    "?Theme": "theme",
    "?Path": "path",
    "RepeatablePath": "strings",
    "RepeatableStringMap": "strings",
    "RepeatableReadableIO": "strings",
    "RepeatableCommand": "strings",
    "RepeatableFontVariation": "strings",
    "RepeatableCodepointMap": "strings",
    "RepeatableClipboardCodepointMap": "strings",
    "KeyRemapSet": "strings",
    "?ColorList": "strings",
    "?TerminalColor": "color",
    "TerminalColor": "color",
    "?BoldColor": "color",
    "?MetricModifier": "string",
    "WindowPadding": "string",
    "SelectionWordChars": "string",
    "MouseScrollMultiplier": "string",
    "BackgroundBlur": "string",
    "?Command": "string",
    "?WorkingDirectory": "string",
    "Limit": "string"
  },

  "compactTypes": ["?MetricModifier", "WindowPadding", "Limit"],

  "colorKeywords": {
    "?TerminalColor": ["cell-foreground", "cell-background"],
    "TerminalColor": ["cell-foreground", "cell-background"],
    "?BoldColor": ["bright"]
  },

  "settings": {
    "background-image":         { "pick": "image" },
    "bell-audio-path":          { "pick": "audio" },
    "custom-shader":            { "pick": "file" },
    "gtk-custom-css":           { "pick": "file" },
    "config-file":              { "pick": "file" },
    "working-directory":        { "pick": "folder", "placeholder": "home, inherit, or a path" },
    "font-family":              { "type": "fonts", "placeholder": "Add a font…" },
    "font-family-bold":         { "type": "fonts", "placeholder": "Same as font-family" },
    "font-family-italic":       { "type": "fonts", "placeholder": "Same as font-family" },
    "font-family-bold-italic":  { "type": "fonts", "placeholder": "Same as font-family" },
    "window-title-font-family": { "type": "font" },
    "font-size":                { "min": 4, "max": 72, "step": 0.5, "unit": "pt" },
    "font-feature":             { "placeholder": "e.g. -calt, ss01" },
    "font-thicken-strength":    { "min": 0, "max": 255, "step": 1 },
    "theme":                    { "placeholder": "Name, or light:Name,dark:Name" },
    "background":               { "type": "color" },
    "foreground":               { "type": "color" },
    "minimum-contrast":         { "min": 1, "max": 21, "step": 0.1 },
    "faint-opacity":            { "min": 0, "max": 1, "step": 0.05 },
    "background-opacity":       { "min": 0, "max": 1, "step": 0.01 },
    "background-image-opacity": { "min": 0, "max": 1, "step": 0.05 },
    "unfocused-split-opacity":  { "min": 0.15, "max": 1, "step": 0.05 },
    "cursor-opacity":           { "min": 0, "max": 1, "step": 0.05 },
    "bell-audio-volume":        { "min": 0, "max": 1, "step": 0.05 },
    "window-padding-x":         { "placeholder": "2 or 2,4 (pt)" },
    "window-padding-y":         { "placeholder": "2 or 2,4 (pt)" },
    "macos-custom-icon":        { "type": "path", "pick": "image" },
    "abnormal-command-exit-runtime": { "unit": "ms", "min": 0 },
    "click-repeat-interval":    { "unit": "ms", "min": 0 },
    "image-storage-limit":      { "unit": "bytes", "min": 0 },
    "linux-cgroup-memory-limit": { "unit": "bytes", "min": 0 },
    "linux-cgroup-processes-limit": { "min": 0 },
    "window-position-x":        { "unit": "px" },
    "window-position-y":        { "unit": "px" },
    "quick-terminal-animation-duration": { "unit": "s", "min": 0, "max": 2, "step": 0.05 },
    "clipboard-write-limit-bytes": { "placeholder": "bytes" },
    "scrollback-limit-bytes":   { "placeholder": "bytes" },
    "scrollback-limit-lines":   { "placeholder": "unlimited or lines" },
    "window-width":             { "min": 0, "unit": "cells" },
    "window-height":            { "min": 0, "unit": "cells" },
    "background-blur":          { "placeholder": "false, true, or a radius like 20" },
    "mouse-scroll-multiplier":  { "placeholder": "precision:1,discrete:3" },
    "command":                  { "placeholder": "Your login shell" },
    "env":                      { "placeholder": "NAME=value" },
    "macos-option-as-alt":      { "type": "enum", "values": ["false", "true", "left", "right"], "nullable": true },
    "auto-update-channel":      { "type": "enum", "values": ["stable", "tip"], "nullable": true },
    "adjust-cell-width":        { "placeholder": "e.g. 10% or 1" },
    "adjust-cell-height":       { "placeholder": "e.g. 10% or 1" }
  }
}
